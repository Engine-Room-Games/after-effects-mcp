<?xml version="1.0" encoding="UTF-8"?>
<!--
  Two extensions, one bundle (issue #283).

  games.engine-room.ae-mcp.bridge is the bridge: client/index.html + main.js,
  the HTTP/WS server, Node enabled. It is an invisible extension (Type Custom,
  AutoVisible false, no Menu) started by After Effects' activate event, so it
  runs at every launch and never opens a window. check_setup's CEP-log match
  is on the bundle id, so it covers both extensions.

  games.engine-room.ae-mcp.panel is the optional window under
  Window > Extensions > AE MCP Bridge. No Node, no server: it shows what the
  bridge reports over a CEP event (client/status.js), and closing or opening
  it never touches the bridge. It keeps the id the old visible bridge had, so
  a workspace saved with that panel docked restores this window into the same
  frame, still a Panel, instead of a Panel slot naming a hidden extension.

  If a host turns out not to start the hidden extension, the fallback is to
  give the bridge back its old Lifecycle and UI (Type Panel, AutoVisible true,
  a Menu) under the .panel id and drop the status extension; index.html still
  renders the status.
  See docs/fragile-areas-bridge.md, "CEP and the panel".
-->
<ExtensionManifest Version="11.0" ExtensionBundleId="games.engine-room.ae-mcp" ExtensionBundleVersion="0.5.2"
                   ExtensionBundleName="AE MCP Bridge" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="games.engine-room.ae-mcp.bridge" Version="0.5.2" />
    <Extension Id="games.engine-room.ae-mcp.panel" Version="0.5.2" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="games.engine-room.ae-mcp.bridge">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <ScriptPath>./jsx/boot.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
            <Event>applicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry>
            <Size><Height>1</Height><Width>1</Width></Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="games.engine-room.ae-mcp.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/status.html</MainPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>AE MCP Bridge</Menu>
          <Geometry>
            <Size><Height>200</Height><Width>320</Width></Size>
            <MinSize><Height>120</Height><Width>240</Width></MinSize>
            <MaxSize><Height>800</Height><Width>800</Width></MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
