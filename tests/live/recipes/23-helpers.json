{
  "recipe": 23,
  "title": "run_jsx helpers: shape() spawns at [0,0]",
  "manual": "ease() on Opacity and on an Ellipse Size: record the number each returns (see recipe 25).",
  "steps": [
    {
      "call": "create_comp",
      "args": {
        "name": "t",
        "width": 1920,
        "height": 1080,
        "frameRate": 30,
        "duration": 5
      },
      "save": "comp",
      "expect": [
        {
          "path": "id",
          "type": "number"
        }
      ]
    },
    {
      "call": "set_active_comp",
      "args": {
        "compId": "${comp.id}"
      }
    },
    {
      "call": "run_jsx",
      "args": {
        "code": "var l = shape(viewerComp(), {name:'Card'}); return l.property('Transform').property('Position').value;"
      },
      "expect": [
        {
          "equals": [
            0,
            0
          ]
        }
      ]
    }
  ]
}
