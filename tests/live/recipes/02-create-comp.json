{
  "recipe": 2,
  "title": "create_comp returns the new comp's id and settings",
  "steps": [
    {
      "call": "create_comp",
      "args": {
        "name": "t",
        "width": 1920,
        "height": 1080,
        "frameRate": 30,
        "duration": 5
      },
      "save": "comp",
      "expect": [
        {
          "path": "id",
          "type": "number"
        },
        {
          "path": "name",
          "equals": "t"
        },
        {
          "path": "width",
          "equals": 1920
        },
        {
          "path": "height",
          "equals": 1080
        },
        {
          "path": "frameRate",
          "equals": 30
        },
        {
          "path": "duration",
          "equals": 5
        }
      ]
    },
    {
      "call": "list_comps",
      "expect": [
        {
          "length": 1
        },
        {
          "path": "[0].id",
          "equals": "${comp.id}"
        }
      ]
    }
  ]
}
