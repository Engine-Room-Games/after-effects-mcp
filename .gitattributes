# `scripts/build-guides.mjs --check` compares generated files against what it
# would write, so a Windows checkout rewriting LF to CRLF would report every one
# of them as stale. The script normalises line endings defensively as well —
# this keeps the working tree honest in the first place.
*.md text eol=lf
*.ts text eol=lf

# Golden files are compared byte for byte (tests/unit/fake-ae-ops.mjs, which
# also normalises CRLF defensively); a Windows checkout must not rewrite them.
tests/unit/golden/** text eol=lf
