<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    The hardened runtime is required for notarization, and it blocks JIT by
    default. Bun embeds JavaScriptCore, which compiles at runtime, so without
    these two the signed binary is refused at launch rather than at sign time —
    a failure that only shows up on a machine other than the one that built it.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
